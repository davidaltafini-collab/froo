# The mini-games are bundled inside the app (mobile/src/components/games/generated) and run
# offline in a WebView, so no games host or LAN address is needed. Regenerate them with
# `npm run build:mobile-games` from the repository root after changing a game.

# Required by standalone Android builds for the native Stores map. Expo Go supplies its own key.
GOOGLE_MAPS_API_KEY=replace-with-a-google-maps-sdk-for-android-key
